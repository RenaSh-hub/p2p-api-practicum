{
  "name": "p2p-api-practicum",
  "version": "1.0.0",
  "description": "A small purchase-to-pay (P2P) practice API for learning API testing with AI agents.",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "smoke": "tsx scripts/smoke.ts",
    "test:api": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "express": "^4.21.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "@types/swagger-ui-express": "^4.1.8",
    "ajv": "^8.20.0",
    "dotenv": "^18.0.9",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
